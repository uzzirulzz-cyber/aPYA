# ── Database ──────────────────────────────────────────────────────────────
# Neon Postgres connection string (set in Vercel env vars)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# ── Auth ─────────────────────────────────────────────────────────────────
# REQUIRED. Generate with: openssl rand -base64 32
# Used to sign session cookies. If not set, auth will not work.
NEXTAUTH_SECRET=""

# ── Admin Bootstrap (optional) ───────────────────────────────────────────
# If set, the first sign-in attempt with ADMIN_EMAIL + the correct password
# will auto-create the admin user and organization. No hardcoded creds.
#
# Leave these BLANK if you want to manually create the admin user via
# prisma or a script. The sign-in route will NOT auto-create anything
# without these env vars.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrator"

# ── Organization Bootstrap (optional) ────────────────────────────────────
# Used when auto-creating the admin's organization on first login.
ORG_NAME="WildTrack"
ORG_LICENSE_KEY="FORENSIQ-2026-WILDTRACK-ADMIN"
ORG_LICENSE_TYPE="professional"
ORG_MAX_USERS="50"

# ── App ──────────────────────────────────────────────────────────────────
NODE_ENV="production"
